            "command": "python3 \"$CLAUDE_PROJECT_DIR/advanced/scripts/hook-bridge.py\" --config \"$CLAUDE_PROJECT_DIR/runtime-config.json\"",
            "timeout": 120
          }
        ]
      }
    ]
